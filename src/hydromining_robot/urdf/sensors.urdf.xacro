<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="camera_rate" default="30"/>
  <xacro:arg name="camera_width" default="640"/>
  <xacro:arg name="camera_height" default="480"/>
  <xacro:arg name="lidar_rate" default="10"/>
  <!-- 阶段六：Gazebo 原生高斯噪声标准差（m），0 表示不写入 <noise>，保持阶段四、五行为不变 -->
  <xacro:arg name="depth_noise_stddev" default="0"/>
  <xacro:arg name="lidar_noise_stddev" default="0"/>
  <xacro:property name="depth_noise" value="$(arg depth_noise_stddev)"/>
  <xacro:property name="lidar_noise" value="$(arg lidar_noise_stddev)"/>

  <!-- 参数：参考 spraying 项目的传感器配置 -->

  <!-- RGB-D 相机 (Intel RealSense D435i 仿真) -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="camera_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_mount_to_camera" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <!-- Gazebo cameras look along +X; align it with the gun's +Z axis. -->
    <origin xyz="0 0 0" rpy="0 ${-pi/2} 0"/>
  </joint>

  <!-- 相机光学中心 -->
  <link name="camera_optical_frame"/>

  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- Gazebo 相机插件 -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <update_rate>$(arg camera_rate)</update_rate>
      <topic>hydromining/camera</topic>
      <!-- Gazebo RGB-D points use native camera axes (+X forward).
           A frame label does not rotate the point data into ROS optical axes. -->
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>$(arg camera_width)</width>
          <height>$(arg camera_height)</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>10.0</far>
        </clip>
        <xacro:if value="${float(depth_noise) > 0}">
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${depth_noise}</stddev>
          </noise>
        </xacro:if>
      </camera>
    </sensor>
  </gazebo>

  <!-- 激光雷达（固定式，安装在基座或支架上）-->
  <!-- 注：也可以放在末端，取决于你的需求 -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="lidar_gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0"
               iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 连接到世界坐标系（固定式）或机器人底座 -->
  <!-- 这里假设连接到机器人底座 -->
  <joint name="base_to_lidar" type="fixed">
    <parent link="panda_link0"/>  <!-- Panda 底座 -->
    <child link="lidar_link"/>
    <origin xyz="-0.2 0 0.5" rpy="0 0 0"/>  <!-- 底座后方 20cm，高 50cm -->
  </joint>

  <!-- Gazebo 激光雷达插件 -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <update_rate>$(arg lidar_rate)</update_rate>
      <topic>hydromining/lidar</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <resolution>1</resolution>
            <min_angle>-${pi}</min_angle>
            <max_angle>${pi}</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-${15.0*pi/180.0}</min_angle>
            <max_angle>${15.0*pi/180.0}</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <xacro:if value="${float(lidar_noise) > 0}">
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>${lidar_noise}</stddev>
          </noise>
        </xacro:if>
      </lidar>
    </sensor>
  </gazebo>

</robot>
