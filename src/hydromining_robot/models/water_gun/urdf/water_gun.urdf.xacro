<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="water_gun">

  <!-- 水枪主体 -->
  <link name="water_gun_body">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.30"/>
      </geometry>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <material name="gun_metal">
        <color rgba="0.3 0.3 0.35 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.30"/>
      </geometry>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="2.5"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0"
               iyy="0.02" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- 喷嘴 -->
  <link name="nozzle">
    <visual>
      <geometry>
        <cylinder radius="0.015" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <material name="nozzle_yellow">
        <color rgba="0.9 0.8 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.015" length="0.08"/>
      </geometry>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0"
               iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="body_to_nozzle" type="fixed">
    <parent link="water_gun_body"/>
    <child link="nozzle"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <!-- TCP (Tool Center Point) - 虚拟链接，喷射参考点 -->
  <link name="tcp"/>

  <joint name="nozzle_to_tcp" type="fixed">
    <parent link="nozzle"/>
    <child link="tcp"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>  <!-- 喷嘴尖端前 5cm -->
  </joint>

  <!-- 相机安装点 -->
  <link name="camera_mount"/>

  <joint name="body_to_camera_mount" type="fixed">
    <parent link="water_gun_body"/>
    <child link="camera_mount"/>
    <origin xyz="0.08 0 0.20" rpy="0 0 0"/>  <!-- 侧面偏移 -->
  </joint>

</robot>
