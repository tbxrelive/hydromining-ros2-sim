<?xml version="1.0"?>
<sdf version="1.9">
  <model name="coal_wall">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="wall_link">
      <!-- 碰撞体（使用相同的网格） -->
      <collision name="wall_collision">
        <geometry>
          <mesh>
            <uri>model://coal_wall/meshes/coal_wall.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.8</mu>
              <mu2>0.8</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <kp>1e7</kp>
              <kd>1e3</kd>
            </ode>
          </contact>
        </surface>
      </collision>

      <!-- 视觉体（相同网格，带材质） -->
      <visual name="wall_visual">
        <geometry>
          <mesh>
            <uri>model://coal_wall/meshes/coal_wall.obj</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <pbr>
            <metal>
              <metalness>0.05</metalness>
              <roughness>0.85</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
