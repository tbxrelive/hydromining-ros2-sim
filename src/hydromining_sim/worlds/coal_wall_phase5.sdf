<?xml version="1.0"?>
<sdf version="1.9">
  <world name="hydromining_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <!-- 传感器系统插件 (RGB-D 相机 + 激光雷达) -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-particle-emitter-system" name="gz::sim::systems::ParticleEmitter"/>
    <plugin filename="libWaterJetEffects.so" name="hydromining::WaterJetEffects"/>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.85 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -1</direction>
    </light>

    <!-- 额外光源：从侧面照亮煤壁细节 -->
    <light name="side_light" type="point">
      <pose>-2 0 2 0 0 0</pose>
      <diffuse>0.6 0.6 0.6 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <linear>0.1</linear>
        <constant>0.2</constant>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 引入凹凸煤壁模型 -->
    <include>
      <uri>model://coal_wall</uri>
      <name>coal_wall</name>
      <pose>1.5 0 1.5 0 -1.9198621771937625 0</pose>
    </include>

    <!-- Acceptance-only overview camera: low-rate, offscreen, no extra GUI. -->
    <model name="jet_overview"><static>true</static><link name="camera">
      <pose>0.0 -1.8 1.35 0 0.32 0.98</pose>
      <sensor name="overview" type="camera">
        <update_rate>2</update_rate><topic>/hydromining/jet/overview</topic>
        <camera><horizontal_fov>1.0</horizontal_fov>
          <image><width>480</width><height>320</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>10</far></clip>
        </camera>
      </sensor>
    </link></model>
  </world>
</sdf>
